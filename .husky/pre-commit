# ultracite
#!/bin/sh
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

PARTIAL_FILES=$(git diff --name-only)

# Not a pipe: a subshell would drop the argument list when the loop ends. Not a symlink: the formatter
# would follow it and rewrite its target, which can sit outside the repo.
set --
while IFS= read -r file; do
  if [ -f "$file" ] && [ ! -L "$file" ]; then
    set -- "$@" "$file"
  fi
done <<EOF
$STAGED_FILES
EOF

FORMAT_EXIT_CODE=0
if [ "$#" -gt 0 ]; then
  bun x ultracite fix "$@" || FORMAT_EXIT_CODE=$?
fi

echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ ! -f "$file" ]; then
    continue
  fi
  if printf '%s\n' "$PARTIAL_FILES" | grep -qxF -- "$file"; then
    echo "Left $file as staged because it has unstaged changes. Check its formatting with \"bun run check\"." >&2
  else
    git add -- "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Ultracite found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "✨ Files formatted by Ultracite"
# ultracite end
