{
  "name": "afterhours",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "turbo": "^2.11.10",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
